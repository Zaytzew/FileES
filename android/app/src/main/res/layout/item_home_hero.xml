<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/filees_space_section"
    android:paddingBottom="@dimen/filees_space">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="@dimen/filees_space">

        <TextView
            android:id="@+id/textHeroEyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_eyebrow"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.Filees.Meta" />

        <TextView
            android:id="@+id/textHeroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/home_title"
            android:textAppearance="@style/TextAppearance.Filees.Heading"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/textHeroCopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Filees.Body"
            tools:text="cloud.atmprojekt.pl" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pulseCount"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@drawable/bg_filees_panel"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textPulseValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Filees.Heading"
            android:textSize="28sp"
            tools:text="3" />

        <TextView
            android:id="@+id/textPulseLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_pulse_repos"
            android:textAppearance="@style/TextAppearance.Filees.Meta" />
    </LinearLayout>
</LinearLayout>
