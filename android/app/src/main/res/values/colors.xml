    <color name="filees_orange">#FF6A00</color>
    <color name="filees_white">#FFFFFF</color>
    <color name="filees_navy_container">#14294D</color>
    <color name="filees_orange_container">#FFDCC2</color>

    <!-- Surface roles from cmd/filees-gui-wails/frontend/theme.css light. -->
