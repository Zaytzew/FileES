<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/filees_row_min"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/filees_row_min"
        android:orientation="horizontal"
        android:paddingTop="@dimen/filees_row_pad_v"
        android:paddingBottom="@dimen/filees_row_pad_v">

        <ImageView
            android:id="@+id/imageBrowseIcon"
            android:layout_width="@dimen/filees_icon"
            android:layout_height="@dimen/filees_icon"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_folder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textBrowseName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:breakStrategy="simple"
                android:ellipsize="end"
                android:hyphenationFrequency="none"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Filees.Name" />

            <TextView
                android:id="@+id/textBrowseMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Filees.Meta" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDownload"
            style="@style/Widget.Filees.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/filees_touch_min"
            android:text="@string/action_download"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/dividerBrowse"
        android:layout_width="match_parent"
        android:layout_height="@dimen/filees_hairline"
        android:background="@color/filees_line" />
</LinearLayout>
