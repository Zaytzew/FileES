<?xml version="1.0" encoding="utf-8"?>
<!-- Same folder glyph as ic_folder.xml/filees-space-symbol-square.svg, but
     WITHOUT its own baked-in navy rounded-square: the adaptive-icon
     background (mipmap-anydpi-v26/ic_launcher.xml) already fills the full
     canvas with filees_navy, so a second, redundant navy shape here just
     duplicates it under a DIFFERENT corner radius than whatever mask the
     launcher applies (circle/squircle/rounded-square all differ by OEM).
     That mismatch was the reported "rozpycha się" (stretches/distorts) -
     content sized for a 42/300 corner radius doesn't survive a circular
     mask cleanly. Fix: only the orange+white glyph, scaled down 0.62x
     around the viewport center so it stays within Android's ~66dp safe
     zone on the 108dp adaptive-icon canvas (108*0.66≈183 viewport units;
     the glyph's own ~237-unit bounding width * 0.62 ≈ 147, comfortably
     inside with margin for whatever shape a given launcher masks to). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="300"
    android:viewportHeight="300">
    <group
        android:pivotX="150"
        android:pivotY="150"
        android:scaleX="0.62"
        android:scaleY="0.62">
        <path
            android:fillColor="#FF6A00"
            android:pathData="M87.2,54L223.36,54L269.36,98.16L269.36,184.64L251.88,184.64L251.88,106.44L216,71.48L87.2,71.48Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M57.76,86.2L184.72,86.2L239.92,139.56L239.92,207.64L222.44,207.64L222.44,147.84L177.36,103.68L57.76,103.68Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M32,118.4H89.96Q97.32,118.4 103.76,124.84L110.2,131.28H182.88L206.8,155.2V228.8H32Z" />
    </group>
</vector>
