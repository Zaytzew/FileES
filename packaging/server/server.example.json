{
  "schema": "filees.server-toolchain/v2",
  "display_name": "Serwer projektowy",
  "root": "/var/filees/onboarding",
  "otp_pepper_file": "/etc/filees/otp.pepper",
  "worker_private_key_file": "/etc/filees/worker_ed25519",
  "worker_public_key_file": "/etc/filees/worker_ed25519.pub",
  "activation": {
    "root": "/var/filees/activation",
    "session_root": "/var/filees/sessions",
    "authorized_keys_file": "/var/filees/activation/authorized_keys",
    "authz_file": "/var/filees/activation/service.authz",
    "service_working_copy": "/var/filees/service-wc",
    "service_repository": "/var/filees/service-repo",
    "repository_name": "filees-service",
    "client_entry_path": "/usr/local/libexec/filees/filees-client-entry",
    "mobile_entry_path": "/usr/local/libexec/filees/filees-mobile-v1",
    "svn_binary": "/usr/local/bin/svn",
    "svnserve_binary": "/usr/local/bin/svnserve"
  },
  "repositories": {
    "root": "/var/filees/repositories",
    "results_root": "/var/filees/repository-operations",
    "whale_root": "/var/filees/repository-operations/whale",
    "data_authz_file": "/var/filees/activation/repositories.authz",
    "svnadmin_binary": "/usr/local/bin/svnadmin",
    "url_prefix": "svn+ssh://_filees-data@filees.example.net/",
    "deletion_archive_root": "/var/filees/repository-operations/deleted-repositories",
    "deletion_retention_days": 30,
    "recovery_admin_contact": "filees-admin@example.net",
    "data_erasure_max_days": 90
  },
  "upload": {
    "intake_root": "/var/tmp/filees-upload-intake",
    "trash_root": "/var/filees/repository-operations/upload-reject",
    "av_command": ["/usr/local/bin/clamdscan", "--no-summary", "--stdout"]
  },
  "public_shares": {
    "enabled": false,
    "base_url": "https://get.example.net",
    "state_root": "/var/filees/repository-operations/public-shares",
    "frost_key_file": "/etc/filees/public-share-frost.key",
    "authority_staging_root": "/var/tmp/filees-public-share-authority",
    "max_size": 1073741824,
    "max_channels_per_realm": 128,
    "password_required": false,
    "backchannel_network": "unix",
    "backchannel_address": "/var/run/filees/public-authority.sock",
    "backchannel_socket_group": "_filees-public"
  },
  "operation_ttl": "30m",
  "otp_attempts": 5,
  "reverse_port_first": 42000,
  "reverse_port_last": 42000,
  "invitation": {
    "server_id": "example-office",
    "server_address": "filees.example.net:2222",
    "known_host": "[filees.example.net]:2222 ssh-ed25519 AAAA...replace-with-the-verified-server-host-key"
  },
  "smtp": {
    "address": "smtp.example.net:587",
    "server_name": "smtp.example.net",
    "client_name": "filees.example.net",
    "from": "filees@example.net",
    "message_id_domain": "filees.example.net",
    "username": "",
    "tls": "starttls",
    "connect_timeout": "10s",
    "command_timeout": "30s"
  }
}
