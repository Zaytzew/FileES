<?xml version="1.0" encoding="utf-8"?>
<!-- The 88dp count box that stood here repeated the folder number the
     metrics panel shows right below, and the server panel a third time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/filees_space_section"
    android:paddingBottom="@dimen/filees_space">

    <TextView
        android:id="@+id/textHeroEyebrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_eyebrow"
        android:textAppearance="@style/TextAppearance.Filees.Eyebrow" />

    <TextView
        android:id="@+id/textHeroTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/home_title"
        android:textAppearance="@style/TextAppearance.Filees.Heading"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/textHeroCopy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.Filees.Body"
        tools:text="Foldery, które ten telefon widzi w strefie." />
</LinearLayout>
