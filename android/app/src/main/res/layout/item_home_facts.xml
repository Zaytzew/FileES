<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/filees_space"
    android:layout_marginBottom="@dimen/filees_space"
    android:background="@drawable/bg_filees_panel"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_fact_server"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.Filees.Meta" />

            <TextView
                android:id="@+id/textFactServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Filees.Name"
                tools:text="atmprojekt:filees" />
        </LinearLayout>

        <View
            android:layout_width="@dimen/filees_hairline"
            android:layout_height="match_parent"
            android:background="@color/filees_line" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_fact_state"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.Filees.Meta" />

            <TextView
                android:id="@+id/textFactFolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Filees.Name"
                tools:text="aktywny" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/filees_hairline"
        android:background="@color/filees_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_fact_access"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.Filees.Meta" />

            <TextView
                android:id="@+id/textFactAccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Filees.Name"
                tools:text="zapis" />
        </LinearLayout>

        <View
            android:layout_width="@dimen/filees_hairline"
            android:layout_height="match_parent"
            android:background="@color/filees_line" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_fact_revision"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.Filees.Meta" />

            <TextView
                android:id="@+id/textFactRevision"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Filees.Name"
                tools:text="r3" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
