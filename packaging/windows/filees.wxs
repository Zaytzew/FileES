<?xml version="1.0" encoding="UTF-8"?>
<!--
  The FileES desktop client for Windows: the daemon, the interface and the
  autostart that keeps the daemon alive.

  This replaces filees-gui.wxs, which packaged the abandoned Fyne client and
  did not ship the daemon at all - so the installer produced something that
  could not sync anything.

  Three decisions worth stating, because each looks like a detail:

  perUser scope and %LOCALAPPDATA%\Programs\FileES. No administrator, nothing
  in Program Files, and it is where the owner's existing hand-made installation
  already lives, so this can take it over without moving a thing.

  A shortcut in the Startup folder rather than a scheduled task. A task needs a
  custom action to register and another to remove, and the only thing it added
  over a shortcut was restart-on-failure - which the supervisor already does,
  and does better, because it watches the daemon rather than the launcher.
  Declarative here, and uninstall removes it without any code of ours running.

  config.json is deliberately absent. It is the owner's production
  configuration; an installer that wrote it would eventually overwrite it. The
  supervisor seeds one on first run instead, where the user's own paths are
  actually known.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="FileES"
      Manufacturer="ATM Projekt"
      Version="$(var.ProductVersion)"
      UpgradeCode="9E4A1F52-8C1D-4E63-9F0A-6B7D2C5A81E4"
      Codepage="1250"
      Scope="perUser">
    <!-- An upgrade replaces the binaries in place. The self-update channel
         does the same thing between releases; both are expected, and a repair
         restores whatever this package carried, which is the honest behaviour
         for an installer that does not own the update lane. -->
    <MajorUpgrade DowngradeErrorMessage="Nowsza wersja FileES jest już zainstalowana." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Every file is written on every install. The executables carry no
         version resource, and Windows Installer keeps an unversioned file
         that changed after it was installed as "modified by the user" - which
         is what self-update does to all of them. On 2026-09-25 the r1558 MSI
         registered 0.1.17.1558 over a self-updated pair and left the r1554
         binaries in place; msiexec /fa was the repair. -->
    <Property Id="REINSTALLMODE" Value="amus" />

    <!-- Use the NEW launcher from the Binary table even for an old MSI.
         Stop only verified supervisors of this user's installation, then
         wait for the daemon's clean exit. Never replace files after a mere
         shutdown ACK or a failed/uncertain stop. -->
    <Binary Id="FileESUpgradeStop" SourceFile="$(var.SourceDir)\filees-launch.exe" />
    <CustomAction Id="StopFileESPair" BinaryRef="FileESUpgradeStop"
                  ExeCommand="--prepare-upgrade &quot;[INSTALLFOLDER].&quot;"
                  Execute="immediate" Return="check" />
    <!-- And started again once the new files are in place, as the Startup
         shortcut would at the next logon. -->
    <CustomAction Id="StartFileESPair" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]filees-launch.exe&quot;"
                  Execute="immediate" Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="StopFileESPair" Before="InstallValidate" Condition="WIX_UPGRADE_DETECTED OR REINSTALL OR Installed" />
      <Custom Action="StartFileESPair" After="InstallFinalize" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
    </InstallExecuteSequence>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="FileES" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="StartupFolder" />

    <Icon Id="FileESIcon" SourceFile="$(var.SourceDir)\filees-folder.ico" />
    <Property Id="ARPPRODUCTICON" Value="FileESIcon" />

    <Component Id="FileESDaemon" Directory="INSTALLFOLDER" Guid="*">
      <File Id="FileESDaemonExe" Source="$(var.SourceDir)\filees.exe" KeyPath="yes" />
    </Component>

    <Component Id="FileESInterface" Directory="INSTALLFOLDER" Guid="*">
      <File Id="FileESInterfaceExe" Source="$(var.SourceDir)\filees-gui-wails.exe" KeyPath="yes" />
    </Component>

    <!-- Compatibility shim for callers of the old script. All current entry
         points run the Go supervisor in filees-launch.exe directly. -->
    <Component Id="FileESSupervisor" Directory="INSTALLFOLDER" Guid="*">
      <File Id="FileESSupervisorScript" Source="$(var.SourceDir)\start-filees.ps1" KeyPath="yes" />
    </Component>

    <!-- The launcher every shortcut points at. It starts the supervisor with
         no window (see cmd/filees-launch). It replaced wscript and
         start-filees.vbs because Windows is retiring VBScript: a clean
         Windows Sandbox answered the old shortcut with "There is no script
         engine for file extension .vbs" on 2026-09-24. The shortcuts name the
         executable itself, so no file association can redirect them. -->
    <Component Id="FileESLauncher" Directory="INSTALLFOLDER" Guid="*">
      <File Id="FileESLauncherExe" Source="$(var.SourceDir)\filees-launch.exe" KeyPath="yes" />
      <!-- All entry points start the pair through its singleton supervisor.
           Interactive launches also raise an already-running Wails window. -->
      <!-- The Start menu entry carries the AUMID the GUI sends its toasts
           under (internal/gui/identity). Without it Windows drops every
           FileES notification silently (owner's report, 2026-09-25). -->
      <Shortcut Id="FileESStartMenuShortcut"
                Directory="ProgramMenuFolder" Name="FileES"
                Description="Pilnuje Twoich plików" Icon="FileESIcon"
                Advertise="no" Target="[INSTALLFOLDER]filees-launch.exe"
                Arguments="--show"
                WorkingDirectory="INSTALLFOLDER">
        <ShortcutProperty Key="System.AppUserModel.ID" Value="ATMProjekt.FileES" />
      </Shortcut>
      <Shortcut Id="FileESDesktopShortcut"
                Directory="DesktopFolder" Name="FileES"
                Description="Pilnuje Twoich plików" Icon="FileESIcon"
                Advertise="no" Target="[INSTALLFOLDER]filees-launch.exe"
                Arguments="--show"
                WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="FileESStartupShortcut"
                Directory="StartupFolder"
                Name="FileES"
                Description="Uruchamia demona FileES i interfejs przy logowaniu"
                Icon="FileESIcon"
                Advertise="no"
                Target="[INSTALLFOLDER]filees-launch.exe"
                WorkingDirectory="INSTALLFOLDER" />
    </Component>

    <!-- The former wscript shim, still shipped: self-update keeps it current
         for installations whose shortcuts an older MSI created and that have
         not been through an MSI upgrade since. -->
    <Component Id="FileESLegacyLauncher" Directory="INSTALLFOLDER" Guid="*">
      <File Id="FileESLauncherScript" Source="$(var.SourceDir)\start-filees.vbs" KeyPath="yes" />
    </Component>

    <!-- The Explorer anchor helper, next to the daemon that looks for it there.
         Only alpha bundles carry it; beta and the Store are built without the
         Cloud Files API (build-msi.ps1 sets WithCfapi). Before 2026-09-28 no
         package installed it at all. -->
    <?if $(var.WithCfapi) = "1" ?>
    <Component Id="FileESAnchorHelper" Directory="INSTALLFOLDER" Guid="*">
      <File Id="FileESAnchorHelperExe" Source="$(var.SourceDir)\filees-cfapi.exe" KeyPath="yes" />
    </Component>
    <?endif?>

    <Component Id="FileESFolderIcon" Directory="INSTALLFOLDER" Guid="*">
      <File Id="FileESFolderIconFile" Source="$(var.SourceDir)\filees-folder.ico" KeyPath="yes" />
    </Component>

    <Component Id="FileESRegistry" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue
          Root="HKCU"
          Key="Software\ATMProjekt\FileES"
          Name="InstalledVersion"
          Type="string"
          Value="$(var.BundleVersion)"
          KeyPath="yes" />
    </Component>

    <!-- Classic per-user menu (Windows 11: Show more options). Explorer only
         sends a folder gesture to the supervisor/GUI; eligibility is checked
         against current daemon state, never inferred from a .svn directory. -->
    <Component Id="FileESExplorerMenu" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\FileES" Name="MUIVerb" Type="string" Value="FileES" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\FileES" Name="SubCommands" Type="string" Value="" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\FileES" Name="Icon" Type="string" Value="[INSTALLFOLDER]filees-folder.ico" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\FileES\shell\01Add" Name="MUIVerb" Type="string" Value="Dodaj do FileES…" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\FileES\shell\01Add" Name="MultiSelectModel" Type="string" Value="Single" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\FileES\shell\01Add\command" Type="string" Value="&quot;[INSTALLFOLDER]filees-launch.exe&quot; --explorer-add &quot;%1&quot;" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\FileES\shell\02Detach" Name="MUIVerb" Type="string" Value="Odłącz folder" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\FileES\shell\02Detach" Name="MultiSelectModel" Type="string" Value="Single" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\FileES\shell\02Detach\command" Type="string" Value="&quot;[INSTALLFOLDER]filees-launch.exe&quot; --explorer-detach &quot;%1&quot;" />
      <RemoveRegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\FileES" Action="removeOnUninstall" />
    </Component>

    <?if $(var.WithCfapi) = "1" ?>
    <Component Id="FileESExplorerVirtualMenu" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\FileES\shell\03Download" Name="MUIVerb" Type="string" Value="Pobierz lokalnie" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\FileES\shell\03Download" Name="MultiSelectModel" Type="string" Value="Single" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\FileES\shell\03Download\command" Type="string" Value="&quot;[INSTALLFOLDER]filees-launch.exe&quot; --explorer-download &quot;%1&quot;" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\FileES\shell\04Release" Name="MUIVerb" Type="string" Value="Zwolnij miejsce" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\FileES\shell\04Release" Name="MultiSelectModel" Type="string" Value="Single" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\FileES\shell\04Release\command" Type="string" Value="&quot;[INSTALLFOLDER]filees-launch.exe&quot; --explorer-release &quot;%1&quot;" />
      <RemoveRegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\FileES\shell\03Download" Action="removeOnUninstall" />
      <RemoveRegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\FileES\shell\04Release" Action="removeOnUninstall" />
    </Component>
    <?endif?>

    <!-- Removed on uninstall because they are ours and nothing else writes
         them. The owner's working copies and his configuration are not listed
         anywhere here and are never touched. -->
    <Component Id="FileESLogs" Directory="INSTALLFOLDER" Guid="*">
      <RemoveFile Id="RemoveDaemonLogs"
                  Directory="INSTALLFOLDER"
                  Subdirectory="logs"
                  Name="*"
                  On="uninstall" />
      <RegistryValue
          Root="HKCU"
          Key="Software\ATMProjekt\FileES"
          Name="LogsManaged"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <Feature Id="ProductFeature" Title="FileES" Level="1">
      <ComponentRef Id="FileESDaemon" />
      <ComponentRef Id="FileESInterface" />
      <ComponentRef Id="FileESSupervisor" />
      <ComponentRef Id="FileESLauncher" />
      <ComponentRef Id="FileESLegacyLauncher" />
      <?if $(var.WithCfapi) = "1" ?>
      <ComponentRef Id="FileESAnchorHelper" />
      <ComponentRef Id="FileESExplorerVirtualMenu" />
      <?endif?>
      <ComponentRef Id="FileESFolderIcon" />
      <ComponentRef Id="FileESRegistry" />
      <ComponentRef Id="FileESExplorerMenu" />
      <ComponentRef Id="FileESLogs" />
      <?if $(var.WithNativeFiles) = "1" ?>
      <ComponentGroupRef Id="NativeSVNFiles" />
      <?endif?>
    </Feature>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.SourceDir)\License.rtf" />
  </Package>
</Wix>
