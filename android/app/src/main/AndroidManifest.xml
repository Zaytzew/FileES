<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:theme="@style/Theme.Filees">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
             Read-only content:// surface over the local manifest cache
             (concept doc §7: a retrieved object is served through a
             read-only content:// grant, never file://, and is never a
             re-upload candidate).
        -->
        <!--
             exported=false: nothing outside this app can query the provider
             directly. A viewer gets access only through a temporary,
             per-URI FLAG_GRANT_READ_URI_PERMISSION grant issued by this app
             (Etap 6 follow-up), never a standing permission string.
        -->
        <provider
            android:name=".ManifestCacheProvider"
            android:authorities="net.filees.mobile.manifest"
            android:exported="false" />

    </application>

</manifest>
