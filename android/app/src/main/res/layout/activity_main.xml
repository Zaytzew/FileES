<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/filees_navy"
            android:minHeight="?attr/actionBarSize"
            app:titleTextColor="@color/filees_white"
            app:navigationIconTint="@color/filees_white"
            app:subtitleTextColor="@color/filees_white"
            app:itemIconTint="@color/filees_white">

            <!-- Real wordmark (branded-assets/filees-space-svg-pack/
                 filees-space-monochrome.svg, recolored white — the toolbar
                 background is always filees_navy in this app, regardless of
                 system day/night, so the "inverted" monochrome variant is
                 the only one ever needed here, not a light/dark switch) in
                 place of app:logo/app:title: MaterialToolbar did not render
                 app:logo at all (concepts/ANDROID_BRAND_ALIGNMENT_CONCEPT.md
                 §4), and a plain child view sidesteps guessing why rather
                 than fighting Toolbar's own title-layout algorithm for
                 space. Shipped as density-bucketed PNGs
                 (drawable-{m,h,x,xx,xxx}hdpi/wordmark_white.png), not a
                 hand-transcribed vector: the wordmark's typography is
                 dozens of curves per letter, too easy to get subtly wrong
                 by hand with no way to render and check here — rasterizing
                 the real SVG and inspecting the PNG is the reliable path.
                 Shown only on the top-level share list
                 (MainActivity#renderList toggles this against the native
                 toolbar.title, which takes over — folder name, back arrow —
                 once a repository is open, so the two never compete for
                 the same space. -->
            <ImageView
                android:id="@+id/brandLockup"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/filees_wordmark_height"
                android:layout_gravity="start|center_vertical"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/wordmark_white" />
        </com.google.android.material.appbar.MaterialToolbar>

        <LinearLayout
            android:id="@+id/barServerAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/filees_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/filees_gutter"
            android:paddingEnd="@dimen/filees_gutter"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- concepts/ANDROID_BRAND_ALIGNMENT_CONCEPT.md §5: purely
                 decorative "breathing" pulse (MainActivity#startPulse),
                 not wired to any connectivity state - Android has none to
                 wire it to (§0). -->
            <ImageView
                android:id="@+id/pulseDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/pulse_dot" />

            <TextView
                android:id="@+id/textServerAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Filees.Meta"
                android:textColor="@color/filees_text"
                tools:text="Serwer: 192.168.1.5:2222" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/filees_hairline"
            android:background="@color/filees_line" />

        <LinearLayout
            android:id="@+id/panelDecisions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/filees_panel"
            android:orientation="vertical"
            android:paddingStart="@dimen/filees_gutter"
            android:paddingEnd="@dimen/filees_gutter"
            android:paddingTop="@dimen/filees_space"
            android:paddingBottom="@dimen/filees_space"
            android:visibility="gone">

            <TextView
                android:id="@+id/textDecisionsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_uploads"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.Filees.Meta" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPending"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:nestedScrollingEnabled="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelUnpaired"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/filees_gutter">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_eyebrow"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.Filees.Meta" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="@dimen/filees_space"
                android:text="@string/home_title"
                android:textAppearance="@style/TextAppearance.Filees.Heading"
                android:textSize="22sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/filees_gutter"
                android:text="@string/home_copy_idle"
                android:textAppearance="@style/TextAppearance.Filees.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonScanQr"
                style="@style/Widget.Filees.Button.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_scan_qr" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerBrowse"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="@dimen/filees_gutter"
            android:paddingEnd="@dimen/filees_gutter"
            android:paddingBottom="88dp"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/buttonAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/action_add"
        android:visibility="gone"
        app:icon="@drawable/ic_file" />

    <LinearLayout
        android:id="@+id/overlayBusy"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/filees_scrim"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/textBusy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center"
            android:textAlignment="center"
            android:text="@string/status_sending"
            android:textAppearance="@style/TextAppearance.Filees.Body" />
    </LinearLayout>
</FrameLayout>
