<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/filees_navy"
            android:minHeight="?attr/actionBarSize"
            app:title="@string/app_name"
            app:titleTextColor="@color/filees_white"
            app:navigationIconTint="@color/filees_white"
            app:subtitleTextColor="@color/filees_white"
            app:itemIconTint="@color/filees_white" />

        <LinearLayout
            android:id="@+id/barServerAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/filees_navy_container"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- concepts/ANDROID_BRAND_ALIGNMENT_CONCEPT.md §5: purely
                 decorative "breathing" pulse (MainActivity#startPulse),
                 not wired to any connectivity state - Android has none to
                 wire it to (§0). -->
            <ImageView
                android:id="@+id/pulseDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/pulse_dot" />

            <TextView
                android:id="@+id/textServerAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/filees_white"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                tools:text="Serwer: 192.168.1.5:2222" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelUnpaired"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonScanQr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_scan_qr" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerBrowse"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="88dp"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/buttonAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/action_add"
        android:visibility="gone"
        app:icon="@drawable/ic_file" />

    <LinearLayout
        android:id="@+id/overlayBusy"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CCFFFFFF"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/textBusy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center"
            android:textAlignment="center"
            android:text="@string/status_sending" />
    </LinearLayout>
</FrameLayout>
