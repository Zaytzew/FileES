<?xml version="1.0" encoding="utf-8"?>
<!-- Panel header. Folders used to be inflated into a LinearLayout inside
     this one list item, which switched recycling off for the whole list and
     rebuilt every row on each bind. They now follow as ordinary items whose
     backgrounds continue this panel (bg_filees_panel_top/middle/bottom);
     BrowseAdapter sets the segment. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/filees_space"
    android:background="@drawable/bg_filees_panel"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/filees_panel_inset">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_server_eyebrow"
            android:textAppearance="@style/TextAppearance.Filees.Eyebrow" />

        <TextView
            android:id="@+id/textServerPanelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Filees.Heading"
            tools:text="atmprojekt:filees" />

        <TextView
            android:id="@+id/textServerPanelMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Filees.Meta"
            tools:text="cloud.atmprojekt.pl:2224" />
    </LinearLayout>

    <TextView
        android:id="@+id/textServerChevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:text="@string/home_chevron"
        android:textAppearance="@style/TextAppearance.Filees.Meta"
        android:textSize="18sp"
        android:visibility="gone" />
</LinearLayout>
