<?xml version="1.0" encoding="utf-8"?>
<!-- Panel header for the phone journal. Entries follow as ordinary list
     items continuing this panel, for the same reason as item_home_server. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/filees_space_section"
    android:background="@drawable/bg_filees_panel"
    android:orientation="vertical"
    android:padding="@dimen/filees_panel_inset">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_journal_title"
        android:textAppearance="@style/TextAppearance.Filees.Eyebrow" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/home_journal_intro"
        android:textAppearance="@style/TextAppearance.Filees.Body" />

    <TextView
        android:id="@+id/textJournalEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/filees_space"
        android:text="@string/home_journal_empty"
        android:textAppearance="@style/TextAppearance.Filees.Name"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
