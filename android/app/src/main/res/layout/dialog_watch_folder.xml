<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/filees_gutter"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/filees_gutter"
        android:paddingBottom="@dimen/filees_gutter">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/watch_card_depth"
            android:textAppearance="@style/TextAppearance.Filees.Heading" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/watch_card_depth_note"
            android:textAppearance="@style/TextAppearance.Filees.Meta" />

        <RadioGroup
            android:id="@+id/groupWatchDepth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonUnwatch"
            style="@style/Widget.Filees.Button.OutlinedButton.Destructive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/action_remove_watched" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/watch_card_recent"
            android:textAppearance="@style/TextAppearance.Filees.Heading" />

        <LinearLayout
            android:id="@+id/listWatchRecent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
