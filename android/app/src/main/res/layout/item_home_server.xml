<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/filees_space"
    android:background="@drawable/bg_filees_panel"
    android:gravity="center_vertical"
    android:minHeight="@dimen/filees_row_min"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_files_eyebrow"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.Filees.Meta" />

        <TextView
            android:id="@+id/textServerPanelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Filees.Heading"
            tools:text="cloud.atmprojekt.pl" />

        <TextView
            android:id="@+id/textServerPanelMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Filees.Meta"
            tools:text="3 foldery" />
    </LinearLayout>

    <TextView
        android:id="@+id/textServerChevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:text="@string/home_chevron"
        android:textAppearance="@style/TextAppearance.Filees.Meta"
        android:textSize="18sp" />
</LinearLayout>
