<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="FileES GUI"
      Manufacturer="ATM Projekt"
      Version="$(var.ProductVersion)"
      UpgradeCode="6C983910-EB56-4B25-95F4-12E0173F47D8"
      Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of FileES GUI is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="FileES" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="FileES" />
    </StandardDirectory>

    <Icon Id="FileESIcon" SourceFile="$(var.SourceDir)\filees-gui.ico" />

    <Component Id="FileESGUI" Directory="INSTALLFOLDER" Guid="*">
      <File Id="FileESGUIExe" Source="$(var.SourceDir)\filees-gui.exe" KeyPath="yes">
        <Shortcut
            Id="FileESStartMenuShortcut"
            Directory="ApplicationProgramsFolder"
            Name="FileES"
            Description="FileES synchronization status"
            Icon="FileESIcon"
            WorkingDirectory="INSTALLFOLDER">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="ATMProjekt.FileES" />
        </Shortcut>
      </File>
      <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
    </Component>

    <Component Id="FileESGUIManifest" Directory="INSTALLFOLDER" Guid="*">
      <File Id="FileESGUIManifest" Source="$(var.SourceDir)\filees-gui.exe.manifest" KeyPath="yes" />
    </Component>

    <!-- Spawned by filees-gui.exe as a background subprocess to render the
         mobile-pairing QR code - no Start Menu shortcut, never launched
         directly by the user. -->
    <Component Id="FileESPairGUI" Directory="INSTALLFOLDER" Guid="*">
      <File Id="FileESPairGUIExe" Source="$(var.SourceDir)\filees-pair-gui.exe" KeyPath="yes" />
    </Component>

    <Component Id="FileESRegistry" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue
          Root="HKCU"
          Key="Software\ATMProjekt\FileES"
          Name="GUIInstalled"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <Feature Id="ProductFeature" Title="FileES GUI" Level="1">
      <ComponentRef Id="FileESGUI" />
      <ComponentRef Id="FileESGUIManifest" />
      <ComponentRef Id="FileESPairGUI" />
      <ComponentRef Id="FileESRegistry" />
    </Feature>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.SourceDir)\License.rtf" />
  </Package>
</Wix>
